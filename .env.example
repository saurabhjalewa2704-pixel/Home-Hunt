# Leave everything blank for local mode: data stays in that browser, board starts empty.
# Fill in the Supabase values to share one board between your two phones. No login is used.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to store listing images in the private bucket. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, server only
ANTHROPIC_API_KEY=            # reads pasted screenshots, and AI extraction when a listing yields fewer than 4 core fields (FR-I4)
ANTHROPIC_VISION_MODEL=       # model for screenshots; defaults to ANTHROPIC_MODEL, then claude-opus-5-5
ANTHROPIC_MODEL=              # defaults to claude-haiku-5-5
GOOGLE_MAPS_API_KEY=          # Places + Routes. Without it, OpenStreetMap + estimated walking times are used
ORS_API_KEY=                  # OpenRouteService, a free routing alternative
ROUTING_PROVIDER=             # "google" or "ors" to force one
